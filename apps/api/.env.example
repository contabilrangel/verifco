# Variáveis da API (apps/api/src/config.ts). Em desenvolvimento, copie para apps/api/.env; as linhas
# comentadas mostram o padrão ou um exemplo. Em produção os valores ficam no ambiente do Dokploy
# (modelos em deploy/dokploy.env.example e deploy/dokploy-managed.env.example), nunca no Git.

# --- Ambiente ---------------------------------------------------------------------------------
# "pnpm start" já usa NODE_ENV=production. Sem NODE_ENV a API roda em modo de desenvolvimento.
# Em produção a API não sobe sem JWT_SECRET (32+ caracteres), ENCRYPTION_KEY e os dois bancos
# PostgreSQL.
# NODE_ENV=production
# Endereço e porta em que a API escuta.
# HOST=0.0.0.0
# PORT=3333

# --- Bancos -----------------------------------------------------------------------------------
# Dois bancos separados: o dos escritórios (DATABASE_URL) e o da plataforma, com as contas do
# painel /sistema, as chaves de IA e a auditoria global (PLATFORM_DATABASE_URL). Trocar só o
# usuário ou o schema no mesmo banco é recusado. Senha com caracteres especiais vai codificada
# na URL (%XX). Sem URLs, o desenvolvimento usa duas pastas PGlite: .data/pglite e .data/platform.
# DATABASE_URL=postgres://escritorios:senha@localhost:5432/verifco_escritorios
# PLATFORM_DATABASE_URL=postgres://plataforma:outra_senha@localhost:5432/verifco_plataforma
# O PGlite é uma conexão só, no mesmo processo: em produção só vale com ALLOW_PGLITE=true, por
# conta e risco de quem instala.
# ALLOW_PGLITE=false
# Como preparar o banco ao iniciar: migrate aplica as migrações de drizzle/ (produção); push
# cria direto do schema.ts.
# DB_SYNC=migrate

# --- Segredos ---------------------------------------------------------------------------------
# Gere cada um com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (o valor de exemplo abaixo é recusado em produção)
# JWT_SECRET assina as sessões. ENCRYPTION_KEY (32 bytes em base64) cifra credenciais e segredos
# de integrações já gravados: guarde uma cópia fora do servidor e nunca troque sem um plano,
# porque sem ela os dados cifrados e os backups restaurados ficam ilegíveis.
JWT_SECRET=troque-esta-chave-com-pelo-menos-32-caracteres
ENCRYPTION_KEY=

# --- Endereços públicos -----------------------------------------------------------------------
# WEB_URL entra nos links dos e-mails (convite, senha, portal); API_URL, nos endereços de webhook
# informados às integrações (Asaas, WhatsApp). CORS_ORIGINS lista as origens aceitas pelo
# navegador, separadas por vírgula.
WEB_URL=http://localhost:5173
API_URL=http://localhost:3333
CORS_ORIGINS=http://localhost:5173

# --- Proxy e limites --------------------------------------------------------------------------
# OBRIGATÓRIO atrás de proxy reverso/balanceador (nginx, Caddy, Traefik, load balancer da nuvem):
# TRUST_PROXY faz a API ler o IP real do cliente no X-Forwarded-For. Sem isso, todos os acessos
# parecem vir do IP do proxy e o limite de tentativas por IP (login, senha, links públicos) bloqueia
# todo mundo junto. Em produção a API avisa no console se receber X-Forwarded-For com isto desligado.
# Use o número de proxies na frente da API (1 = um proxy; o IP do cliente é o que ele acrescentou;
# o proxy precisa conectar à API por rede interna: 127.x, 10.x, 172.16-31.x, 192.168.x, fc00::/7)
# ou os IPs/CIDRs dos proxies separados por vírgula (ex.: TRUST_PROXY=10.0.0.0/8), obrigatório
# quando o proxy chega à API por IP público.
# Não use TRUST_PROXY=true: confia em todos os saltos e o cliente escolhe o próprio IP (a API avisa).
# Não ligue com a API exposta direto na internet: o cliente poderia forjar o cabeçalho.
# No Compose do Dokploy o padrão é 2 (Traefik e Nginx).
# TRUST_PROXY=1
# Limite de tentativas de login, senha, cadastro e links públicos. Ligado por padrão (desligado
# só nos testes); false desliga.
# RATE_LIMIT=true

# --- Cadastro e suporte -----------------------------------------------------------------------
# Cadastro de novos escritórios aberto em /cadastro. Com false, só o painel /sistema cria escritórios.
# SIGNUP_ENABLED=true
# E-mail de contato mostrado aos escritórios (contrato vencido, suporte).
# SUPPORT_EMAIL=suporte@exemplo.com.br
# Só em desenvolvimento: devolve o código do portal e o link de convite na resposta (sem e-mail).
# Recusado em produção.
# DEV_SHOW_ACCESS_CODES=true

# --- Arquivos ---------------------------------------------------------------------------------
# Onde ficam os arquivos enviados e gerados (inclusive os backups dos escritórios):
# local grava em STORAGE_DIR; s3 grava em um bucket compatível com S3.
# STORAGE_DRIVER=local
# Pasta do STORAGE_DRIVER=local: a mesma em todas as instâncias (compartilhada, se estiverem em
# máquinas diferentes). No Compose do Dokploy é o volume uploads, em /app/storage.
STORAGE_DIR=.data/storage
# STORAGE_DRIVER=s3 exige endpoint, bucket e as duas chaves. S3_FORCE_PATH_STYLE=true usa o
# endereço endpoint/bucket/chave, padrão dos serviços compatíveis (MinIO, R2, B2).
# S3_ENDPOINT=https://s3.exemplo.com
# S3_REGION=us-east-1
# S3_BUCKET=verifco-arquivos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# --- E-mail -----------------------------------------------------------------------------------
# E-mail padrão da plataforma: convites, redefinição de senha e avisos de segurança. Cada
# escritório pode configurar o próprio SMTP em Integrações. Deve começar com smtp:// ou smtps://.
# SMTP_URL=smtps://usuario:senha@smtp.exemplo.com:465
SMTP_FROM=Verifco <nao-responda@verifco.com.br>
# Com true, a API recusa iniciar em produção sem SMTP_URL. Padrão false: sobe e avisa no console.
# SMTP_REQUIRED=false

# --- Monitoramento ----------------------------------------------------------------------------
# DSN do Sentry (ou serviço compatível) que recebe os erros 500 e as falhas finais da fila.
# Vazio: nada é enviado.
# SENTRY_DSN=https://chave@o0.ingest.sentry.io/0

# --- Fila de tarefas (e-mails, WhatsApp, cobranças, sincronizações, IA, backups) ---------------
# Padrão: true (cada instância da API também executa a fila). Em produção, recomendado:
# RUN_WORKER=false nas instâncias que atendem o público e uma instância separada com
# RUN_WORKER=true (o mesmo "pnpm start", fora do balanceador), para jobs pesados como o backup do
# escritório não disputarem memória e CPU com as requisições. O Compose do Dokploy já faz isso
# com os serviços api e worker.
# RUN_WORKER=true
# Quantas tarefas cada instância com worker executa ao mesmo tempo (padrão 4; use 2 ou mais): as
# longas (backup, eCAC do escritório, elaboração, Radar) nunca ocupam a última vaga, que fica para
# envios e cobranças. Ao parar (SIGTERM), a API espera até 8 s pelas tarefas em andamento e devolve
# as demais à fila (no docker stop, o padrão de 10 s basta).
# JOB_CONCURRENCY=4

# --- Retenção de dados (em dias, de 1 a 3650) -------------------------------------------------
# Tarefas concluídas, envios de teste e pedidos de senha já usados.
# RETENTION_JOBS_DAYS=30
# Prazo entre excluir um cliente e apagar de vez os dados e arquivos dele (LGPD).
# RETENTION_DELETED_CUSTOMERS_DAYS=90
# Tempo em que os .zip de backup do escritório ficam disponíveis para download. Não confundir com
# BACKUP_RETENTION_DAYS, do backup da infraestrutura (docs/RESTAURACAO.md).
# RETENTION_BACKUPS_DAYS=30

# --- IA da plataforma (legado) ----------------------------------------------------------------
# As conexões de IA são gerenciadas em /sistema/ia. Estas duas só valem enquanto não há conexão
# padrão escolhida no painel.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# --- Fora deste arquivo -----------------------------------------------------------------------
# PLATFORM_OWNER_NAME, PLATFORM_OWNER_EMAIL e PLATFORM_OWNER_PASSWORD (criação do primeiro
# proprietário) e PLATFORM_USER_EMAIL, PLATFORM_USER_PASSWORD, PLATFORM_USER_RESET_2FA e
# PLATFORM_USER_REACTIVATE (redefinição de senha da plataforma) são digitadas ou escolhidas na
# hora pelos comandos deploy/create-owner.sh e deploy/reset-platform-password.sh. Não as grave
# em .env nem no ambiente do serviço.
# As variáveis BACKUP_* pertencem ao serviço de backup do Compose, não à API.
