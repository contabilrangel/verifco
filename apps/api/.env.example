# Ambiente: "pnpm start" já usa NODE_ENV=production. Sem NODE_ENV a API roda em modo de
# desenvolvimento. Em produção a API não sobe sem JWT_SECRET (32+ caracteres), ENCRYPTION_KEY
# e DATABASE_URL de PostgreSQL.
# NODE_ENV=production

# Banco: em desenvolvimento, vazio usa o PGlite embutido (.data/pglite). Em produção use PostgreSQL
# (o PGlite é uma conexão só, no mesmo processo; ALLOW_PGLITE=true assume esse risco).
# DATABASE_URL=postgres://usuario:senha@localhost:5432/verifco
# DB_SYNC=migrate

# Gere cada um com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (o valor de exemplo abaixo é recusado em produção)
JWT_SECRET=troque-esta-chave-com-pelo-menos-32-caracteres
ENCRYPTION_KEY=

# OBRIGATÓRIO atrás de proxy reverso/balanceador (nginx, Caddy, Traefik, load balancer da nuvem):
# TRUST_PROXY faz a API ler o IP real do cliente no X-Forwarded-For. Sem isso, todos os acessos
# parecem vir do IP do proxy e o limite de tentativas por IP (login, senha, links públicos) bloqueia
# todo mundo junto. Em produção a API avisa no console se receber X-Forwarded-For com isto desligado.
# Use o número de proxies na frente da API (1 = um proxy; o IP do cliente é o que ele acrescentou;
# o proxy precisa conectar à API por rede interna: 127.x, 10.x, 172.16-31.x, 192.168.x, fc00::/7)
# ou os IPs/CIDRs dos proxies separados por vírgula (ex.: TRUST_PROXY=10.0.0.0/8), obrigatório
# quando o proxy chega à API por IP público.
# Não use TRUST_PROXY=true: confia em todos os saltos e o cliente escolhe o próprio IP (a API avisa).
# Não ligue com a API exposta direto na internet: o cliente poderia forjar o cabeçalho.
# TRUST_PROXY=1

# Fila de tarefas (envios, backup, IA, sincronizações). RUN_WORKER=false numa instância que só
# atende HTTP (com outro processo rodando a fila). Jobs ao mesmo tempo por processo; no máximo
# JOB_OFFICE_CONCURRENCY de um mesmo escritório (vazio = JOB_CONCURRENCY - 1); prazo para um job de
# um processo que caiu voltar à fila; espera no SIGTERM antes de devolver os jobs em andamento.
# RUN_WORKER=true
# JOB_CONCURRENCY=4
# JOB_OFFICE_CONCURRENCY=3
# JOB_LEASE_SECONDS=300
# SHUTDOWN_TIMEOUT_SECONDS=25

# Só em desenvolvimento: devolve o código do portal e o link de convite na resposta (sem e-mail)
# DEV_SHOW_ACCESS_CODES=true

WEB_URL=http://localhost:5173
API_URL=http://localhost:3333
CORS_ORIGINS=http://localhost:5173
STORAGE_DIR=.data/storage

# E-mail padrão (cada escritório pode configurar o próprio SMTP em Integrações)
# SMTP_URL=smtps://usuario:senha@smtp.exemplo.com:465
SMTP_FROM=Verifco <nao-responda@verifco.com.br>

# Assistentes de IA (Claude)
# ANTHROPIC_API_KEY=
