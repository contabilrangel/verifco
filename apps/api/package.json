{
  "name": "@verifco/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "platform:owner": "tsx --env-file-if-exists=.env src/db/platform-owner.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:check": "drizzle-kit generate --name verificacao && drizzle-kit generate --config drizzle.platform.config.ts --name verificacao && node -e \"const o=require('child_process').execSync('git status --porcelain drizzle drizzle-platform').toString();if(o.trim()){console.error('Um schema mudou sem migração. Rode pnpm db:generate e faça commit de apps/api/drizzle.\\n'+o);process.exit(1)}\"",
    "db:generate:platform": "drizzle-kit generate --config drizzle.platform.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.1.2",
    "@verifco/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "drizzle-kit": "^0.31.5",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.1.0",
    "jszip": "^3.10.1",
    "nodemailer": "^10.0.15",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.0",
    "tsx": "^4.20.0",
    "yazl": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.0",
    "@types/yazl": "^3.3.1",
    "typescript": "5.9.3",
    "vitest": "^4.0.0"
  }
}
