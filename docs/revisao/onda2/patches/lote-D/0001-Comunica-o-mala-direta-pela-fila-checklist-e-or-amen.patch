+        );
+      }
+      if (rows.length) {
+        // os mesmos jobs que ctx.jobs.enqueue grava um a um (chave de idempotência = id do envio)
+        const sealedBy = new Map(block.map((p) => [p.item.idempotencyKey, p.sealed]));
+        await tx
