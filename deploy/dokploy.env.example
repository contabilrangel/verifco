APP_URL=https://app.verifco.com.br
CORS_ORIGINS=https://app.verifco.com.br,https://ir.verifco.com.br,https://painel.verifco.com.br
# URLs usadas pela aplicação; bancos distintos, com credenciais distintas.
DATABASE_URL=postgres://verifco:SENHA_DO_BANCO_ESCRITORIOS@postgres:5432/verifco
PLATFORM_DATABASE_URL=postgres://verifco_platform:SENHA_DO_BANCO_PLATAFORMA@postgres-platform:5432/verifco_platform
# Senhas para inicializar os dois containers PostgreSQL na VM.
# Devem coincidir com as respectivas URLs acima. Gere 32 bytes em hexadecimal.
POSTGRES_PASSWORD=
PLATFORM_POSTGRES_PASSWORD=
# Gere 32 bytes aleatórios em base64 para cada uma destas chaves, separadamente.
JWT_SECRET=
ENCRYPTION_KEY=
SMTP_URL=
SMTP_FROM=Verifco <nao-responda@verifco.com.br>
