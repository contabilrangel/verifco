# Ambiente do serviço Compose no Dokploy para ./compose.dokploy-managed.yml (bancos como serviços
# independentes do Dokploy; instalação atual). Cole em Environment e preencha; os valores reais
# nunca vão para o Git. Linhas comentadas mostram o padrão: só descomente para mudar.
# Instalação e restauração: docs/DOKPLOY.md e docs/RESTAURACAO.md.

# --- Obrigatórias -----------------------------------------------------------------------------
# URL pública com HTTPS, sem barra final; entra nos links enviados por e-mail.
APP_URL=https://app.verifco.com.br
# Endereços públicos aceitos pelo navegador, separados por vírgula. Vazio: usa APP_URL.
CORS_ORIGINS=https://app.verifco.com.br,https://ir.verifco.com.br,https://painel.verifco.com.br
# Copie a Internal Connection URL de cada serviço PostgreSQL do Dokploy.
# Use dois bancos diferentes. Não publique portas externas para a aplicação.
DATABASE_URL=
PLATFORM_DATABASE_URL=
# Preserve as chaves existentes ao trocar apenas os bancos.
# JWT_SECRET assina as sessões. ENCRYPTION_KEY cifra as credenciais gravadas: guarde uma cópia
# fora da VM (sem ela, um backup restaurado não abre os segredos).
JWT_SECRET=
ENCRYPTION_KEY=

# --- Cadastro, suporte e e-mail ---------------------------------------------------------------
# Cadastro de novos escritórios aberto em /cadastro. Com false, só o painel /sistema cria escritórios.
# SIGNUP_ENABLED=true
# E-mail de contato mostrado aos escritórios (contrato vencido, suporte).
# SUPPORT_EMAIL=
# E-mail padrão da plataforma (convites, redefinição de senha, avisos de segurança), no formato
# smtps://usuario:senha@servidor:465. Os escritórios também podem configurar o próprio SMTP.
SMTP_URL=
SMTP_FROM=Verifco <nao-responda@verifco.com.br>
# Com true, a API recusa iniciar sem SMTP_URL. Padrão false: sobe e avisa no log.
# SMTP_REQUIRED=false

# --- Monitoramento ----------------------------------------------------------------------------
# DSN do Sentry (ou compatível) que recebe os erros 500 e as falhas finais da fila. Vazio: desligado.
# SENTRY_DSN=

# --- Arquivos ---------------------------------------------------------------------------------
# local (padrão) grava no volume uploads; s3 grava em um bucket compatível com S3 e exige
# S3_ENDPOINT, S3_BUCKET e as duas chaves. Trocar o driver não move os arquivos já gravados.
# STORAGE_DRIVER=local
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# --- Ajustes finos (os padrões servem para esta instalação) -----------------------------------
# Proxies na frente da API: 2 = Traefik do Dokploy e Nginx da web. Não altere sem mudar a topologia.
# TRUST_PROXY=2
# Limite de tentativas de login, senha, cadastro e links públicos. Ligado por padrão.
# RATE_LIMIT=true
# Tarefas simultâneas do worker (1 a 32).
# JOB_CONCURRENCY=4
# Retenção, em dias: tarefas concluídas e pedidos de senha usados; prazo entre excluir um cliente
# e apagar de vez os dados dele (LGPD); disponibilidade dos .zip de backup do escritório.
# RETENTION_JOBS_DAYS=30
# RETENTION_DELETED_CUSTOMERS_DAYS=90
# RETENTION_BACKUPS_DAYS=30
# IA legada: só vale enquanto não há conexão padrão escolhida em /sistema/ia.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# --- Backup da infraestrutura (opcional; docs/RESTAURACAO.md) ---------------------------------
# Liga o serviço backup do Compose: um backup por dia dos dois bancos e do volume uploads.
# COMPOSE_PROFILES=backup
# Chave PÚBLICA age (age1...) que cifra os backups; mais de uma, separadas por vírgula. A chave
# privada fica fora da VM e nunca entra neste ambiente. Sem chave pública o backup não roda.
# BACKUP_AGE_RECIPIENT=
# off grava os backups sem cifrar (certificados e documentos fiscais em claro). Não recomendado.
# BACKUP_ENCRYPTION=age
# Destino: bucket compatível com S3, fora desta VM. BACKUP_S3_ENDPOINT vazio usa a AWS.
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=
# BACKUP_S3_BUCKET=
# Pasta dentro do bucket.
# BACKUP_S3_PREFIX=verifco
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# Endereço endpoint/bucket (padrão dos serviços compatíveis); false usa bucket.endpoint.
# BACKUP_S3_FORCE_PATH_STYLE=true
# Destino local, só para a primeira configuração ou testes: /backups é o volume backup-local, na
# MESMA VM, e não protege contra a perda do servidor. Pode ser usado junto com o bucket.
# BACKUP_LOCAL_DIR=/backups
# Apaga do destino os backups com mais de N dias (0 = não apaga; use o ciclo de vida do bucket),
# mantendo sempre os BACKUP_KEEP_MIN mais novos.
# BACKUP_RETENTION_DAYS=30
# BACKUP_KEEP_MIN=7
# Hora do backup diário (0 a 23) no fuso de BACKUP_TZ.
# BACKUP_SCHEDULE_HOUR=03
# BACKUP_TZ=America/Sao_Paulo
# false deixa o volume uploads fora do backup (use com STORAGE_DRIVER=s3, quando os arquivos
# estão no bucket da aplicação, que precisa de proteção própria).
# BACKUP_INCLUDE_STORAGE=true
# Commit implantado, gravado no manifesto de cada backup (opcional, informativo).
# APP_COMMIT=
